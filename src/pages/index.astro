
---
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Section from "../components/Section.astro";
import EntryList from "../components/EntryList.astro";
import NewsList from "../components/NewsList.astro";
import PubItem from "../components/PubItem.astro";
import DemoNotice from "../components/DemoNotice.astro";
import TemplateCta from "../components/TemplateCta.astro";

import { site, absoluteUrl } from "../site.config.js";

import {
  profile,
  about,
  news,
  education,
  supervisors,
  publications,
  workingPapers,
  experience,
  projects,
  funding,
  awards,
  academicService,
  teaching,
  lastUpdated,
} from "../data.js";

const title = [profile.nameEn, profile.nameCn]
  .filter(Boolean)
  .join(" ");

// Structured data for search engines.
const email = profile.links.find((l) =>
  l.href.startsWith("mailto:")
)?.href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.nameEn,

  ...(profile.nameCn && {
    alternateName: profile.nameCn,
  }),

  url: absoluteUrl("/"),
  jobTitle: site.seo.jobTitle,
  description: site.description,

  ...(email && { email }),

  ...(site.seo.affiliation && {
    affiliation: {
      "@type": "CollegeOrUniversity",
      ...site.seo.affiliation,
    },
  }),

  alumniOf: education
    .filter(
      (e) =>
        e.url &&
        e.org !== site.seo.affiliation?.name
    )
    .map((e) => ({
      "@type": "CollegeOrUniversity",
      name: e.org,
      sameAs: e.url,
    })),

  ...(site.seo.location && {
    homeLocation: {
      "@type": "Place",
      address: {
        "@type": "PostalAddress",
        addressLocality:
          site.seo.location.locality,
        addressCountry:
          site.seo.location.country,
      },
    },
  }),

  knowsAbout: site.seo.knowsAbout,

  sameAs: profile.links
    .filter((l) => /^https?:/.test(l.href))
    .map((l) => l.href),
};
---

<Base title={title} path="/" jsonLd={jsonLd}>
  {site.demoNotice && <DemoNotice repo={site.repo} />}

  <header class="site-header">
    <h1>
      {profile.nameEn}
      {profile.nameCn && (
        <span class="cn">{profile.nameCn}</span>
      )}
    </h1>
  </header>

  <div class="page">
    <Sidebar />

    <main>
      {
        about.length > 0 && (
          <Section id="about" title="About Me">
            <div class="prose">
              {about.map((para) => (
                <p set:html={para} />
              ))}
            </div>
          </Section>
        )
      }

      {
        news.length > 0 && (
          <Section id="news" title="News">
            <NewsList items={news} />
          </Section>
        )
      }

      {
        education.length > 0 && (
          <Section id="education" title="Education">
            <EntryList items={education} />
          </Section>
        )
      }

      {
        supervisors.length > 0 && (
          <Section
            id="supervisors"
            title="Supervisory Team"
          >
            <EntryList items={supervisors} />
          </Section>
        )
      }

      {
        publications.length > 0 && (
          <Section
            id="publications"
            title="Publications"
          >
            <div class="pubs">
              {publications.map((p) => (
                <PubItem {...p} />
              ))}
            </div>
          </Section>
        )
      }

      {
        workingPapers.length > 0 && (
          <Section
            id="working-papers"
            title="Working Papers"
          >
            <div class="pubs">
              {workingPapers.map((p) => (
                <PubItem {...p} />
              ))}
            </div>
          </Section>
        )
      }

      {
        experience.length > 0 && (
          <Section
            id="experience"
            title="Research Experience"
          >
            <EntryList items={experience} />
          </Section>
        )
      }

      {
        projects.length > 0 && (
          <Section id="projects" title="Projects">
            <EntryList items={projects} />
          </Section>
        )
      }

      {
        funding.length > 0 && (
          <Section id="funding" title="Funding">
            <EntryList items={funding} />
          </Section>
        )
      }

      {
        awards.length > 0 && (
          <Section
            id="awards"
            title="Awards & Honours"
          >
            <EntryList items={awards} />
          </Section>
        )
      }

      {
        academicService.length > 0 && (
          <Section
            id="academic-service"
            title="Academic Service"
          >
            <EntryList items={academicService} />
          </Section>
        )
      }

      {
        teaching.length > 0 && (
          <Section id="teaching" title="Teaching">
            <EntryList items={teaching} />
          </Section>
        )
      }

      {site.demoNotice && (
        <TemplateCta repo={site.repo} />
      )}

      <footer>
        Last updated {lastUpdated}
      </footer>
    </main>
  </div>
</Base>
